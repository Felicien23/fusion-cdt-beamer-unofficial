% beamerthemeFusionCDT.sty
%
% Unofficial, community-maintained LaTeX Beamer template inspired by the
% Fusion CDT visual identity. This is not an official Fusion CDT template and
% is not endorsed by Fusion CDT or its partner institutions.
%
% Copyright (c) 2026 The fusion-cdt-beamer-unofficial contributors
% SPDX-License-Identifier: MIT
% The MIT licence covers this file. The Fusion CDT logo and the Figtree
% typeface are third-party assets with their own terms: see
% THIRD_PARTY_NOTICES.md.
%
% Compile with LuaLaTeX. Usage and options are documented in README.md.
%
% ChkTeX: TikZ coordinate expressions and the nested slide templates below
% produce false positives for warnings 31 and 36, so they are off in this file.
% chktex-file 31
% chktex-file 36
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeFusionCDT}[2026/11/19 v1.0.0 Unofficial Fusion CDT Beamer theme]

\RequirePackage{iftex}
\RequirePackage{tikz}
\usetikzlibrary{calc}

% ---------------------------------------------------------------- options
\newif\iffcdt@sectionpages
\fcdt@sectionpagestrue
\newif\iffcdt@cream
\DeclareOptionBeamer{nosectionpages}{\fcdt@sectionpagesfalse}
\DeclareOptionBeamer{cream}{\fcdt@creamtrue}
\ProcessOptionsBeamer

% ---------------------------------------------------------------- palette
% Website colours of fusion-cdt.ac.uk, as recorded in the CSS of the Fusion
% CDT GitHub organisation. Sources: docs/branding.md.
\definecolor{fcdtBlue}{HTML}{277CB3}     % header and footer bars
\definecolor{fcdtDarkBlue}{HTML}{1D6394} % text, links, top strip
\definecolor{fcdtPaleBlue}{HTML}{D3DBE6} % text on the dark-blue strip
\definecolor{fcdtCream}{HTML}{EEEEE6}    % page background
\definecolor{fcdtMagenta}{HTML}{DC2099}  % arrows, focus and hover accent
\definecolor{fcdtLime}{HTML}{C5D300}     % lime accent
% Neutral and derived colours introduced for legibility (not branding).
\definecolor{fcdtInk}{HTML}{1B2631}      % body text, 15:1 on white
\colorlet{fcdtMagentaText}{fcdtMagenta!88!black} % alert text, >4.5:1 on white
\colorlet{fcdtLimeDark}{fcdtLime!55!black}       % plot lines, 5:1 on white
\definecolor{fcdtGrey}{HTML}{5F6B76}     % secondary text and plot lines
\colorlet{fcdtBlueTint}{fcdtPaleBlue!45!white}
\colorlet{fcdtMagentaTint}{fcdtMagenta!7!white}
\iffcdt@cream\colorlet{fcdtPage}{fcdtCream}\else\colorlet{fcdtPage}{white}\fi

% ---------------------------------------------------------------- fonts
% Figtree, the website's typeface, is bundled in theme/fonts/. LuaLaTeX finds
% it through the TeX search path, so the theme folder can live anywhere that
% TEXINPUTS reaches. Other engines fall back to Latin Modern Sans.
\usefonttheme{professionalfonts}
\ifLuaTeX
  \RequirePackage{fontspec}
  % Lua strings use quotes that ChkTeX mistakes for TeX quotation marks.
  \edef\fcdt@fontdir{\directlua{
    local f = kpse.find_file('Figtree-Medium.otf', 'tex') % chktex 32
    local d = ''
    if f then d = f:match('^(.*/)') or './' end
    tex.sprint(-2, d)}}
  \ifx\fcdt@fontdir\@empty
    \PackageWarningNoLine{beamerthemeFusionCDT}{%
      Figtree font files not found on the TeX search path.\MessageBreak
      Using Latin Modern Sans instead (see README, Troubleshooting)}
  \else
    \setsansfont{Figtree}[
      Path           = \fcdt@fontdir,
      Extension      = {.otf},
      UprightFont    = *-Medium,
      ItalicFont     = *-MediumItalic,
      BoldFont       = *-Bold,
      BoldItalicFont = *-BoldItalic]
  \fi
\else
  \ifPDFTeX
    \RequirePackage[T1]{fontenc}
    \RequirePackage{lmodern}
  \else
    \RequirePackage{fontspec}
  \fi
  \PackageWarningNoLine{beamerthemeFusionCDT}{%
    Figtree is only loaded under LuaLaTeX.\MessageBreak
    Using Latin Modern Sans instead}
\fi
\renewcommand\familydefault{\sfdefault}

\setbeamerfont{title}{size=\LARGE, series=\bfseries}
\setbeamerfont{subtitle}{size=\large}
\setbeamerfont{author}{size=\normalsize, series=\bfseries}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small}
\setbeamerfont{frametitle}{size=\Large, series=\bfseries}
\setbeamerfont{framesubtitle}{size=\normalsize, series=\mdseries}
\setbeamerfont{block title}{size=\normalsize, series=\bfseries}
\setbeamerfont{footline}{size=\scriptsize}
\setbeamerfont{caption}{size=\footnotesize}
\setbeamerfont{alerted text}{series=\bfseries}

% ---------------------------------------------------------------- colours
\setbeamercolor{normal text}{fg=fcdtInk, bg=fcdtPage}
\setbeamercolor{structure}{fg=fcdtDarkBlue}
\setbeamercolor{alerted text}{fg=fcdtMagentaText}
\setbeamercolor{example text}{fg=fcdtDarkBlue}
\setbeamercolor{frametitle}{fg=fcdtDarkBlue}
\setbeamercolor{framesubtitle}{fg=fcdtGrey}
\setbeamercolor{item}{fg=fcdtBlue}
\setbeamercolor{subitem}{fg=fcdtMagenta}
\setbeamercolor{enumerate item}{fg=white, bg=fcdtBlue}
\setbeamercolor{block title}{fg=white, bg=fcdtBlue}
\setbeamercolor{block body}{fg=fcdtInk, bg=fcdtBlueTint}
\setbeamercolor{block title alerted}{fg=white, bg=fcdtMagentaText}
\setbeamercolor{block body alerted}{fg=fcdtInk, bg=fcdtMagentaTint}
\setbeamercolor{block title example}{fg=white, bg=fcdtDarkBlue}
\setbeamercolor{block body example}{fg=fcdtInk, bg=fcdtCream}
\setbeamercolor{footline}{fg=white, bg=fcdtBlue}
\setbeamercolor{caption name}{fg=fcdtDarkBlue}
\setbeamercolor{bibliography entry author}{fg=fcdtDarkBlue}
\setbeamercolor{bibliography entry note}{fg=fcdtGrey}

% ---------------------------------------------------------------- geometry
\setbeamersize{text margin left=0.7cm, text margin right=0.7cm}
\setbeamertemplate{navigation symbols}{}

% ---------------------------------------------------------------- texts
% Text in the dark-blue strip of the blue slides, and the partner line on the
% title slide (partners as listed on fusion-cdt.ac.uk in November 2026).
\newcommand*\fcdt@striptext{EPSRC Centre for Doctoral Training in Fusion Power}
\newcommand\fcdtsetstriptext[1]{\renewcommand*\fcdt@striptext{#1}}
\newcommand*\fcdt@partners{Durham \textperiodcentered{} Liverpool
  \textperiodcentered{} Manchester \textperiodcentered{} Oxford
  \textperiodcentered{} Sheffield \textperiodcentered{} York}
\newcommand\fcdtsetpartners[1]{\renewcommand*\fcdt@partners{#1}}

% ---------------------------------------------------------------- logo
% The Fusion CDT logo with white lettering, as on the website's blue header.
% It is not distributed with the theme: scripts/fetch-logo.sh downloads it to
% theme/logo/. It is found through the TeX search path, or in the folder given
% by \fcdtassetdir{<folder/>}. Its rays are transparent, so it is only ever
% placed on fcdtBlue.
\newcommand*\fcdt@assets{}
\newcommand*\fcdtassetdir[1]{\renewcommand*\fcdt@assets{#1}}
\newcommand*\fcdt@logofile{fusion-cdt-logo-white.pdf}
\newif\iffcdt@logo
\AtBeginDocument{%
  \IfFileExists{\fcdt@assets\fcdt@logofile}{\fcdt@logotrue}{%
    \fcdt@logofalse
    \PackageWarningNoLine{beamerthemeFusionCDT}{%
      Logo file \fcdt@logofile\space not found.\MessageBreak
      Slides will show no logo. Run make logo, or see\MessageBreak
      the README section on the logo}}}
\newcommand\fcdtlogo[1]{%
  \iffcdt@logo\includegraphics[height=#1]{\fcdt@assets\fcdt@logofile}%
  \else\rule{0pt}{#1}\fi}

% Magenta and lime stripe, as on the Fusion CDT social preview card
% (62 per cent magenta, 38 per cent lime). #1 = height.
\newcommand\fcdt@stripe[1]{%
  \fill[fcdtMagenta] (0,0) rectangle (0.62\paperwidth,#1);
  \fill[fcdtLime] (0.62\paperwidth,0) rectangle (\paperwidth,#1);}

% ---------------------------------------------------------------- content slides
\setbeamertemplate{background canvas}{%
  \begin{tikzpicture}
    \fill[fcdtPage] (0,0) rectangle (\paperwidth,\paperheight);
  \end{tikzpicture}}

\setbeamertemplate{frametitle}{%
  \vspace*{0.35cm}%
  \begin{beamercolorbox}[wd=\paperwidth, leftskip=0.7cm, rightskip=0.7cm]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle\par
    \ifx\insertframesubtitle\@empty\else
      \vspace{0.1em}%
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}%
       \insertframesubtitle\par}%
    \fi
    \par\nointerlineskip\vspace{2mm}%
    \tikz{\fill[fcdtMagenta] (0,0) rectangle (1.24cm,0.7mm);
          \fill[fcdtLime] (1.24cm,0) rectangle (2cm,0.7mm);}\par
  \end{beamercolorbox}}

% Blue footer bar with the logo, short author and title, and slide number.
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth, ht=0.72cm, dp=0pt]{footline}
    \begin{tikzpicture}
      \useasboundingbox (0,0) rectangle (\paperwidth,0.72cm);
      \node[anchor=west, inner sep=0pt] at (0.7cm,0.36cm) {\fcdtlogo{0.48cm}};
      \node[anchor=center, inner sep=0pt, text=white,
            font=\usebeamerfont{footline}] at (0.5\paperwidth,0.36cm)
        {\insertshortauthor\ifx\insertshortauthor\@empty\else
         \ \textbar\ \fi\insertshorttitle};
      \node[anchor=east, inner sep=0pt, text=white,
            font=\usebeamerfont{footline}] at ($(\paperwidth,0.36cm)+(-0.7cm,0)$)
        {\insertframenumber\,/\,\inserttotalframenumber};
    \end{tikzpicture}%
  \end{beamercolorbox}}

\setbeamertemplate{itemize item}{\raisebox{0.18ex}{\rule{0.42em}{0.42em}}}
\setbeamertemplate{itemize subitem}{\textendash}
\setbeamertemplate{itemize subsubitem}{\textperiodcentered}
\setbeamertemplate{enumerate items}[square]
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{bibliography item}[text]

% ---------------------------------------------------------------- plots
% pgfplots cycle list in the theme colours (used when pgfplots is loaded).
\AtBeginDocument{\@ifpackageloaded{pgfplots}{%
  \pgfplotscreateplotcyclelist{fusioncdt}{%
    {fcdtBlue, mark=*, line width=1.1pt},
    {fcdtMagenta, mark=square*, line width=1.1pt},
    {fcdtDarkBlue, dashed, mark=triangle*, line width=1.1pt},
    {fcdtLimeDark, mark=diamond*, line width=1.1pt},
    {fcdtGrey, densely dotted, mark=o, line width=1.1pt}}%
  \pgfplotsset{cycle list name=fusioncdt}}{}}

% ---------------------------------------------------------------- blue slides
% Top strip as on the website: dark blue, pale-blue centred text.
\newcommand\fcdt@topstrip{%
  \fill[fcdtDarkBlue] ($(0,\paperheight)+(0,-0.55cm)$) rectangle (\paperwidth,\paperheight);
  \ifx\fcdt@striptext\@empty\else
    \node[text=fcdtPaleBlue, font=\scriptsize]
      at ($(0.5\paperwidth,\paperheight)+(0,-0.275cm)$) {\fcdt@striptext};
  \fi}

\newcommand\fcdt@bluecanvas{%
  \fill[fcdtBlue] (0,0) rectangle (\paperwidth,\paperheight);
  \fcdt@topstrip
  \fcdt@stripe{0.3cm}}

\newcommand\fcdt@titlebg{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
    \fcdt@bluecanvas
    \node[anchor=north west, inner sep=0pt] at ($(0,\paperheight)+(0.9cm,-1.15cm)$)
      {\fcdtlogo{1.45cm}};
    \node[anchor=north west, inner sep=0pt, text width=0.82\paperwidth, align=left,
          text=white] (fcdt-title) at ($(0,\paperheight)+(0.9cm,-3.25cm)$) {%
      {\usebeamerfont{title}\inserttitle\par}%
      \ifx\insertsubtitle\@empty\else
        \vspace{0.3em}{\usebeamerfont{subtitle}\insertsubtitle\par}%
      \fi};
    \node[anchor=north west, inner sep=0pt, text width=0.82\paperwidth, align=left,
          text=white] at ($(fcdt-title.south west)+(0,-0.45cm)$) {%
      {\usebeamerfont{author}\insertauthor\par}%
      \ifx\insertinstitute\@empty\else{\usebeamerfont{institute}\insertinstitute\par}\fi
      \vspace{0.15em}{\usebeamerfont{date}\insertdate\par}};
    \ifx\fcdt@partners\@empty\else
      \node[anchor=south west, inner sep=0pt, text=white, font=\scriptsize]
        at (0.9cm,0.55cm) {\fcdt@partners};
    \fi
  \end{tikzpicture}}

\newcommand\fcdt@sectionbg{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
    \fcdt@bluecanvas
    \node[anchor=north west, inner sep=0pt] at ($(0,\paperheight)+(0.9cm,-1.15cm)$)
      {\fcdtlogo{0.9cm}};
    \node[anchor=west, inner sep=0pt, text width=0.82\paperwidth, align=left,
          text=white] at (0.9cm,0.43\paperheight) {%
      {\usebeamerfont{subtitle}Section \insertsectionnumber\par}%
      \vspace{0.25em}{\usebeamerfont{title}\insertsectionhead\par}};
  \end{tikzpicture}}

\newcommand\fcdt@closingtext{}
\newcommand\fcdt@closingbg{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
    \fcdt@bluecanvas
    \node[anchor=north west, inner sep=0pt] at ($(0,\paperheight)+(0.9cm,-1.15cm)$)
      {\fcdtlogo{1.45cm}};
    \node[anchor=north west, inner sep=0pt, text width=0.82\paperwidth, align=left,
          text=white] (fcdt-end) at ($(0,\paperheight)+(0.9cm,-3.4cm)$)
      {{\fontsize{30}{34}\selectfont\bfseries\fcdt@closingtext\par}};
    \node[anchor=north west, inner sep=0pt, text width=0.82\paperwidth, align=left,
          text=white] at ($(fcdt-end.south west)+(0,-0.5cm)$) {%
      {\usebeamerfont{author}\insertauthor\par}%
      \ifx\insertinstitute\@empty\else{\usebeamerfont{institute}\insertinstitute\par}\fi};
  \end{tikzpicture}}

% ---------------------------------------------------------------- public commands
\newcommand\fcdttitleframe{{%
  \setbeamertemplate{background}{\fcdt@titlebg}%
  \setbeamertemplate{footline}{}%
  \begin{frame}[plain,noframenumbering]\end{frame}}}

\newcommand\fcdtsectionframe{{%
  \setbeamertemplate{background}{\fcdt@sectionbg}%
  \setbeamertemplate{footline}{}%
  \begin{frame}[plain,noframenumbering]\end{frame}}}

\newcommand\fcdtclosingframe[1]{{%
  \renewcommand\fcdt@closingtext{#1}%
  \setbeamertemplate{background}{\fcdt@closingbg}%
  \setbeamertemplate{footline}{}%
  \begin{frame}[plain,noframenumbering]\end{frame}}}

\iffcdt@sectionpages
  \AtBeginSection{\fcdtsectionframe}
\fi

\mode<all>
\endinput
